# Copy to .env and fill in.
# Free key: https://developer.ticketmaster.com/ (Discovery API). If empty, the Event Service serves demo data.
TICKETMASTER_API_KEY=
TICKETMASTER_COUNTRY=ES
JWT_SECRET=change-me-to-a-long-random-string
# AI assistant (https://platform.claude.com/). If empty, the assistant uses a simple rule-based parser.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
