# Copy to .env and fill in.
# Free key: https://developer.ticketmaster.com/ (Discovery API). If empty, the Event Service serves demo data.
TICKETMASTER_API_KEY=
TICKETMASTER_COUNTRY=ES
# Artist history (https://www.setlist.fm/settings/api). If empty, the artist page shows no past concerts.
SETLISTFM_API_KEY=
# MusicBrainz asks for an identifying User-Agent, ideally with a contact: "Zyntra/0.2 ( you@example.com )"
MUSICBRAINZ_USER_AGENT=
# City shown by default on the home page and artist pages
DEFAULT_CITY=Bilbao
# Basque open-data concert agenda (no key needed). Set to off to disable.
KULTURKLIK=on
JWT_SECRET=change-me-to-a-long-random-string
# AI assistant: set ONE of these keys (Gemini wins if both are set). If both are empty, a rule-based parser is used.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Claude key: https://platform.claude.com/
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
